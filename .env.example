PORT=3000
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RPM=15
STAGE_B_MODE=llm_rag
PIPELINE_TIMEOUT_MS=240000
PYTHON_EXECUTABLE=python
TRANSCRIPTS_BUCKET=ehr-compliance-monitor-yogiri-2026
# Comma-separated exact website origins for the Lambda/API Gateway CORS policy.
ALLOWED_ORIGINS=http://localhost:3000
# Public API Gateway base URL. The local dashboard reads it at runtime; static hosting embeds it during `npm run build:frontend`.
EHR_API_BASE_URL=https://ra5qh05emk.execute-api.ap-south-1.amazonaws.com
# Public Cognito hosted UI settings; never put a client secret here.
EHR_COGNITO_DOMAIN=https://example.auth.ap-south-1.amazoncognito.com
EHR_COGNITO_CLIENT_ID=public_app_client_id
EHR_COGNITO_REDIRECT_URI=http://localhost:3000/
EHR_COGNITO_LOGOUT_URI=http://localhost:3000/
